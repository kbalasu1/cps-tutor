# Copy this file to .streamlit/secrets.toml for local development
# and fill in real values. Never commit the real secrets.toml (it's
# already in .gitignore).
#
# On Streamlit Community Cloud, set these instead via the app's
# Settings -> Secrets box. On Hugging Face Spaces, via
# Settings -> Repository secrets.

GEMINI_API_KEY = "your-gemini-api-key-here"

# Optional: only needed for persistent storage via Turso (hosted libSQL).
# Leave both blank/omitted to fall back to a local SQLite file, which
# does NOT survive redeploys or sleep on Streamlit Cloud / HF Spaces.
# Get these from https://turso.tech after creating a free database:
#   turso db show <db-name> --url
#   turso db tokens create <db-name>
TURSO_DATABASE_URL = "libsql://your-db-name-your-org.turso.io"
TURSO_AUTH_TOKEN = "your-turso-auth-token-here"
